{
    "name": "hac-plugin",
    "version": "0.1.0",
    "private": true,
    "description": "HA-C — Home Assistant Controller: the Stream Deck plugin",
    "license": "MIT",
    "author": "Boris Kemper",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart de.boriskemper.ha-controller\"",
        "link": "streamdeck link de.boriskemper.ha-controller.sdPlugin",
        "validate": "streamdeck validate de.boriskemper.ha-controller.sdPlugin",
        "pack": "streamdeck pack de.boriskemper.ha-controller.sdPlugin --force"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0",
        "@mdi/js": "^7.4.47",
        "@rocklobster42195/streamdeck-kit": "^0.1.0-alpha.1",
        "bonjour-service": "^1.4.4",
        "home-assistant-js-websocket": "^9.7.0",
        "mqtt": "^5.16.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node24": "^24.0.5",
        "rollup": "^4.62.2",
        "sharp": "^0.35.4",
        "tslib": "^2.6.2"
    }
}
