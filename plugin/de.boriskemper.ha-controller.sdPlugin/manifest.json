{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "Home Assistant Controller",
    "Version": "0.1.0.0",
    "Author": "Boris Kemper",
    "Category": "Home Assistant Controller",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "Description": "Switch and show anything on your MQTT broker: Home Assistant, zigbee2mqtt, Tasmota, Shelly, ESPHome, ioBroker, Node-RED.\nUnofficial community plugin, not affiliated with Elgato.\n\nIcons by https://pictogrammers.com",
    "Icon": "imgs/plugin/marketplace",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        },
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        }
    ],
    "Nodejs": {
        "Version": "24",
        "Debug": "enabled"
    },
    "UUID": "de.boriskemper.ha-controller",
    "Actions": [
        {
            "Name": "Switch",
            "UUID": "de.boriskemper.ha-controller.switch",
            "Icon": "imgs/actions/switch/icon",
            "Tooltip": "Switch a light or plug on and off, and see its state.",
            "PropertyInspectorPath": "ui/switch.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/switch/key"
                }
            ]
        },
        {
            "Name": "Value",
            "UUID": "de.boriskemper.ha-controller.value",
            "Icon": "imgs/actions/value/icon",
            "Tooltip": "Show a value with its unit, e.g. a temperature or power, as text or on a half-circle gauge.",
            "PropertyInspectorPath": "ui/value.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/value/key"
                }
            ]
        },
        {
            "Name": "Trigger",
            "UUID": "de.boriskemper.ha-controller.publish",
            "Icon": "imgs/actions/publish/icon",
            "Tooltip": "Run something once: a scene, script, button or automation, or an MQTT message (e.g. opening a gate).",
            "PropertyInspectorPath": "ui/publish.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/publish/key"
                }
            ]
        },
        {
            "Name": "Multi-state",
            "UUID": "de.boriskemper.ha-controller.multi-state",
            "Icon": "imgs/actions/multi-state/icon",
            "Tooltip": "Step through several values, e.g. fan off, 1, 2, 3, and see the current one.",
            "PropertyInspectorPath": "ui/multi-state.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/multi-state/key"
                }
            ]
        },
        {
            "Name": "Slider",
            "UUID": "de.boriskemper.ha-controller.slider",
            "Icon": "imgs/actions/slider/icon",
            "Tooltip": "Set a value with a dial: brightness, a thermostat's setpoint, a blind. Push switches on and off.",
            "PropertyInspectorPath": "ui/slider.html",
            "Controllers": [
                "Encoder"
            ],
            "Encoder": {
                "layout": "layouts/canvas.json",
                "TriggerDescription": {
                    "Rotate": "Set the value",
                    "Push": "On / off",
                    "Touch": "On / off"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/slider/key"
                }
            ]
        }
    ]
}
