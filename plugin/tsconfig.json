{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "customConditions": ["node"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM"],
        "strict": true,
        "noImplicitOverride": true,
        "resolveJsonModule": true,
        "experimentalDecorators": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.test.ts"]
}
